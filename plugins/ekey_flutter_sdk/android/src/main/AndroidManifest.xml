<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <!--
             necekey://callback (focus_uri) handler for eKey 2.0 app-to-app login.
             The SDK class lives in EkeySDK.jar (no manifest of its own).

               launchMode="singleTask"  +  default (host-package) task affinity
               excludeFromRecents="true"

             singleTask = ONE instance that always receives necekey://callback via
             onNewIntent, and (because its affinity differs from the Flutter
             template MainActivity's android:taskAffinity="") it lives in its own
             task. That reliably dismisses after the redirect. The plugin then
             re-focuses the host app's task once the result is delivered (see
             EkeyFlutterSdkPlugin.bringToFront) so the user lands back on the app,
             not on the Chrome tab used for web login. excludeFromRecents keeps the
             throwaway task out of the recents list.

             Do NOT use singleTop or taskAffinity="" here — both break the
             necekey://callback routing on a Flutter host (verified on-device).
        -->
        <activity
            android:name="com.example.ekeysdk.EkeyLoginActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="callback"
                    android:scheme="necekey" />
            </intent-filter>
        </activity>
    </application>

</manifest>
