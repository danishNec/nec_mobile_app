<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <!--
             necekey://callback (focus_uri) handler for eKey 2.0 app-to-app login.

             The bundled EkeySDK.aar declares this activity as launchMode="singleTop"
             with its default task affinity. That breaks the return trip on hosts whose
             launcher Activity sets android:taskAffinity="" — the Flutter default
             MainActivity does exactly that: the incoming necekey://callback intent can't
             be matched to the running task, so Android starts a NEW EkeyLoginActivity via
             onCreate instead of routing to onNewIntent. The WebView then reloads from
             scratch and the login never completes ("stuck on the WebView page").

             Overriding to launchMode="singleTask" + taskAffinity="" guarantees a single
             instance that always receives the callback through onNewIntent, and keeps it
             in the host app's own task so finish() returns straight to MainActivity.
             Merges into the host app automatically; nothing to add to the host.
        -->
        <activity
            android:name="com.example.ekeysdk.EkeyLoginActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoTitleBar"
            tools:replace="android:launchMode,android:taskAffinity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="callback"
                    android:scheme="necekey" />
            </intent-filter>
        </activity>
    </application>

</manifest>
